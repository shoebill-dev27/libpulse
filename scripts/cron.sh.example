#!/usr/bin/env bash
# Unattended cadence (T13). Install with `crontab -e` (owner action — incurs
# daily LLM cost when ANTHROPIC_API_KEY is set in .env):
#
#   17 6 * * *  /home/shinobu/claude-dev/libpulse/scripts/cron.sh.example cycle
#   23 7 * * 1  /home/shinobu/claude-dev/libpulse/scripts/cron.sh.example report
#
set -euo pipefail
cd "$(dirname "$0")/.."
# cron runs with PATH=/usr/bin:/bin only. uv lives in ~/.local/bin, so without
# this every verification returns UNVERIFIABLE ("uv is required for environment
# management") and the corpus silently stops growing. That is exactly what
# happened between 2026-06 and 2026-09: 26 cases, 26 unverifiable, 0 noticed.
export PATH="$HOME/.local/bin:$PATH"
command -v uv >/dev/null || { echo "FATAL: uv not on PATH; verification would return UNVERIFIABLE for every case" >&2; exit 1; }
set -a; [ -f .env ] && source .env; set +a
case "${1:-cycle}" in
  cycle)
    .venv/bin/libpulse cycle
    .venv/bin/libpulse prune-venvs --keep-days 30
    git add data/corpus reports && git commit -q -m "cron: cycle $(date +%F)" || true
    # Publishing the dataset was left as a manual owner step, so it ran exactly
    # once (2026-09-08). It cost nothing only because the corpus has not changed
    # since; the next time it grows, a manual step is a step that does not run.
    # Owner approved automating it 2026-10-02.
    .venv/bin/libpulse export-hf >/dev/null
    if [ -n "${HF_TOKEN:-}" ] && command -v hf >/dev/null; then
      hf upload "${HF_DATASET:-shoebill-dev27/libpulse-breaking-changes}" dist/hf . \
        --repo-type dataset --commit-message "cron: corpus $(date +%F)" \
        || echo "WARN: hf upload failed; the published dataset is now stale" >&2
    else
      echo "WARN: HF_TOKEN unset or hf CLI missing; dataset NOT refreshed (OWNER_OPERATIONS 2)" >&2
    fi
    ;;
  report)
    .venv/bin/libpulse report
    git add reports && git commit -q -m "cron: weekly report $(date +%F)" || true
    ;;
esac
